 번 하면 여덟 번은 성공해요.","emphasis numbers"],[140.03,142.87,"구독이랑 좋아요 한 번씩 눌러 주시고요.","cta_mid"],[143.25,149.36,"정리할게요. 주고 바로 뛰기, 원터치 리턴, 그리고 앞발로 패스.","recap"],[149.81,153.77,"이 세 가지만 지키면 2대1 패스 무조건 됩니다.","recap"],[154.29,158.79,"오늘은 여기까지. 다음 영상에서 만나요. 감사합니다.","closing"],[160.47,165.53,"자, 컷! 수고했어요. 물 좀 마시고 한 번 더 찍을까?","postroll"],[166.0,167.56,"네, 좋아요.","postroll"]],"demos":[[46.71,53.71,[47.51,52.91]],[78.52,84.52,[79.32]],[93.34,99.34,[94.14,98.54]],[131.73,139.73,[132.53,135.73,138.93]]]},"MSGRAW01":{"duration":201.52,"transcript":[{"start":0.82,"end":6.68,"text":"안녕하세요. 여러분. 오늘은 퍼스트 터치에 대해서 같이 알아볼게요.","words":[{"w":"안녕하세요.","s":0.82,"e":1.58,"p":0.96},{"w":"여러분.","s":2.16,"e":2.56,"p":0.97},{"w":"오늘은","s":3.02,"e":3.96,"p":1.0},{"w":"퍼스트","s":3.96,"e":4.5,"p":1.0},{"w":"터치에","s":4.5,"e":5.04,"p":0.98},{"w":"대해서","s":5.04,"e":5.34,"p":1.0},{"w":"같이","s":5.34,"e":5.96,"p":1.0},{"w":"알아볼게요.","s":5.96,"e":6.68,"p":0.99}]},{"start":7.1,"end":19.34,"text":"어... 왜 다들 첫 터치에서 공으로 칠까요? 사실 이건 발 기술 문제라기보다 준비 자세 문제인 경우가 많아요.","words":[{"w":"어...","s":7.1,"e":7.9,"p":0.69},{"w":"왜","s":7.9,"e":8.7,"p":1.0},{"w":"다들","s":8.7,"e":9.06,"p":1.0},{"w":"첫","s":9.06,"e":9.28,"p":1.0},{"w":"터치에서","s":9.28,"e":9.88,"p":0.97},{"w":"공으로","s":9.88,"e":10.74,"p":0.89},{"w":"칠까요?","s":10.74,"e":11.18,"p":1.0},{"w":"사실","s":14.02,"e":14.96,"p":1.0},{"w":"이건","s":14.96,"e":15.28,"p":0.96},{"w":"발","s":15.28,"e":16.04,"p":0.93},{"w":"기술","s":16.04,"e":16.42,"p":0.97},{"w":"문제라기보다","s":16.42,"e":17.12,"p":1.0},{"w":"준비","s":17.12,"e":17.86,"p":1.0},{"w":"자세","s":17.86,"e":18.16,"p":0.99},{"w":"문제인","s":18.16,"e":18.6,"p":1.0},{"w":"경우가","s":18.6,"e":18.92,"p":1.0},{"w":"많아요.","s":18.92,"e":19.34,"p":1.0}]},{"start":19.88,"end":22.72,"text":"그래서 오늘은 세 가지만 기억하시면 돼요.","words":[{"w":"그래서","s":19.88,"e":20.28,"p":1.0},{"w":"오늘은","s":20.28,"e":21.02,"p":1.0},{"w":"세","s":21.02,"e":21.48,"p":0.78},{"w":"가지만","s":21.48,"e":21.82,"p":0.96},{"w":"기억하시면","s":21.82,"e":22.46,"p":1.0},{"w":"돼요.","s":22.46,"e":22.72,"p":0.99}]},{"start":24.24,"end":30.72,"text":"자, 첫 번째 포인트. 공이 오기 전에 고개를 들어서 주변을 먼저 보세요.","words":[{"w":"자,","s":24.24,"e":24.8,"p":0.53},{"w":"첫","s":25.04,"e":25.56,"p":1.0},{"w":"번째","s":25.56,"e":25.84,"p":0.99},{"w":"포인트.","s":25.84,"e":26.32,"p":1.0},{"w":"공이","s":26.74,"e":27.5,"p":1.0},{"w":"오기","s":27.5,"e":27.72,"p":1.0},{"w":"전에","s":27.72,"e":27.98,"p":1.0},{"w":"고개를","s":27.98,"e":28.52,"p":1.0},{"w":"들어서","s":28.52,"e":28.96,"p":1.0},{"w":"주변을","s":28.96,"e":30.04,"p":1.0},{"w":"먼저","s":30.04,"e":30.34,"p":1.0},{"w":"보세요.","s":30.34,"e":30.72,"p":1.0}]},{"start":30.72,"end":37.3,"text":"많은 분들이 공만 보고 있다가 공이 오면 그제서야 어디로 갈지 생각하시거든요.","words":[{"w":"많은","s":30.72,"e":31.66,"p":0.92},{"w":"분들이","s":31.66,"e":32.06,"p":1.0},{"w":"공만","s":32.06,"e":32.54,"p":1.0},{"w":"보고","s":32.54,"e":32.76,"p":1.0},{"w":"있다가","s":32.76,"e":33.18,"p":1.0},{"w":"공이","s":33.18,"e":34.12,"p":0.98},{"w":"오면","s":34.12,"e":34.42,"p":1.0},{"w":"그제서야","s":34.42,"e":35.2,"p":1.0},{"w":"어디로","s":35.2,"e":35.74,"p":1.0},{"w":"갈지","s":35.74,"e":36.24,"p":1.0},{"w":"생각하시거든요.","s":36.24,"e":37.3,"p":1.0}]},{"start":37.72,"end":41.68,"text":"그러면 이미 늦어요. 수비가 바로 부터원이니까요.","words":[{"w":"그러면","s":37.72,"e":38.36,"p":1.0},{"w":"이미","s":38.36,"e":38.74,"p":1.0},{"w":"늦어요.","s":38.74,"e":39.16,"p":1.0},{"w":"수비가","s":39.58,"e":40.0,"p":1.0},{"w":"바로","s":40.0,"e":40.5,"p":1.0},{"w":"부터원이니까요.","s":40.5,"e":41.68,"p":0.62}]},{"start":42.12,"end":48.16,"text":"이게 진짜 핵심이에요. 공을 받기 전에 다음 동작이 이미 정해져 있어야 해요.","words":[{"w":"이게","s":42.12,"e":42.34,"p":1.0},{"w":"진짜","s":42.34,"e":42.88,"p":1.0},{"w":"핵심이에요.","s":42.88,"e":43.58,"p":1.0},{"w":"공을","s":44.26,"e":44.66,"p":1.0},{"w":"받기","s":44.66,"e":44.94,"p":0.97},{"w":"전에","s":44.94,"e":45.2,"p":1.0},{"w":"다음","s":45.2,"e":46.12,"p":1.0},{"w":"동작이","s":46.12,"e":46.72,"p":1.0},{"w":"이미","s":46.72,"e":47.04,"p":1.0},{"w":"정해져","s":47.04,"e":47.56,"p":1.0},{"w":"있어야","s":47.56,"e":47.9,"p":1.0},{"w":"해요.","s":47.9,"e":48.16,"p":0.99}]},{"start":50.66,"end":54.44,"text":"그래서 인사이드로 공을 받을 때는 발목에...","words":[{"w":"그래서","s":50.66,"e":51.26,"p":1.0},{"w":"인사이드로","s":51.26,"e":52.48,"p":1.0},{"w":"공을","s":52.48,"e":52.78,"p":1.0},{"w":"받을","s":52.78,"e":53.08,"p":1.0},{"w":"때는","s":53.08,"e":53.3,"p":1.0},{"w":"발목에...","s":53.3,"e":54.44,"p":0.79}]},{"start":54.44,"end":56.92,"text":"아, 잠깐만요. 다시 할게요.","words":[{"w":"아,","s":54.44,"e":54.9,"p":0.99},{"w":"잠깐만요.","s":55.04,"e":55.66,"p":1.0},{"w":"다시","s":56.1,"e":56.52,"p":1.0},{"w":"할게요.","s":56.52,"e":56.92,"p":1.0}]},{"start":58.62,"end":64.62,"text":"그래서 인사이드로 공을 받을 때는 발목에 힘을 빼고 부드럽게 받아야 해요.","words":[{"w":"그래서","s":58.62,"e":59.38,"p":0.63},{"w":"인사이드로","s":59.38,"e":60.14,"p":0.98},{"w":"공을","s":60.14,"e":60.42,"p":0.99},{"w":"받을","s":60.42,"e":60.66,"p":0.99},{"w":"때는","s":60.66,"e":60.82,"p":0.93},{"w":"발목에","s":60.82,"e":62.18,"p":0.88},{"w":"힘을","s":62.18,"e":62.54,"p":1.0},{"w":"빼고","s":62.54,"e":62.96,"p":1.0},{"w":"부드럽게","s":62.96,"e":63.9,"p":0.99},{"w":"받아야","s":63.9,"e":64.28,"p":0.99},{"w":"해요.","s":64.28,"e":64.62,"p":0.89}]},{"start":64.8,"end":77.34,"text":"한번 좋아요. 이렇게 공이 발에 딱 붙어야 해요.","words":[{"w":"한번","s":64.8,"e":65.38,"p":0.69},{"w":"좋아요.","s":65.38,"e":66.46,"p":0.92},{"w":"이렇게","s":75.52,"e":75.68,"p":1.0},{"w":"공이","s":75.68,"e":76.08,"p":1.0},{"w":"발에","s":76.08,"e":76.36,"p":0.99},{"w":"딱","s":76.36,"e":76.52,"p":1.0},{"w":"붙어야","s":76.52,"e":77.0,"p":1.0},{"w":"해요.","s":77.0,"e":77.34,"p":1.0}]},{"start":78.1,"end":83.76,"text":"그리고 이건 그냥 참고로만 들으세요. 빼고 하시는 게...","words":[{"w":"그리고","s":78.1,"e":78.28,"p":0.98},{"w":"이건","s":78.28,"e":79.26,"p":0.98},{"w":"그냥","s":79.26,"e":79.54,"p":0.99},{"w":"참고로만","s":79.54,"e":80.34,"p":1.0},{"w":"들으세요.","s":80.34,"e":80.8,"p":0.98},{"w":"빼고","s":82.82,"e":83.02,"p":0.91},{"w":"하시는","s":83.02,"e":83.34,"p":1.0},{"w":"게...","s":83.34,"e":83.76,"p":0.48}]},{"start":87.54,"end":96.44,"text":"자, 두번째 포인트는 디딤밤이 공이랑 너무 가까우면 터치가 무조건 길어져요.","words":[{"w":"자,","s":87.54,"e":87.8,"p":0.52},{"w":"두번째","s":88.12,"e":89.32,"p":0.81},{"w":"포인트는","s":89.32,"e":90.12,"p":0.99},{"w":"디딤밤이","s":90.12,"e":91.04,"p":0.58},{"w":"공이랑","s":91.04,"e":93.42,"p":0.37},{"w":"너무","s":93.42,"e":93.76,"p":0.95},{"w":"가까우면","s":93.76,"e":94.44,"p":0.99},{"w":"터치가","s":94.44,"e":95.18,"p":0.96},{"w":"무조건","s":95.18,"e":95.8,"p":1.0},{"w":"길어져요.","s":95.8,"e":96.44,"p":0.99}]},{"start":97.06,"end":100.4,"text":"디딤발은 공 옆으로 한 뼘 정도 떨어뜨려 주세요.","words":[{"w":"디딤발은","s":97.06,"e":97.66,"p":0.97},{"w":"공","s":97.66,"e":98.22,"p":1.0},{"w":"옆으로","s":98.22,"e":98.7,"p":0.96},{"w":"한","s":98.7,"e":98.94,"p":0.7},{"w":"뼘","s":98.94,"e":99.22,"p":0.86},{"w":"정도","s":99.22,"e":99.52,"p":0.89},{"w":"떨어뜨려","s":99.52,"e":100.12,"p":0.96},{"w":"주세요.","s":100.12,"e":100.4,"p":0.35}]},{"start":101.12,"end":103.58,"text":"그래야 몸이 공을 덮을 수 있어요.","words":[{"w":"그래야","s":101.12,"e":101.98,"p":1.0},{"w":"몸이","s":101.98,"e":102.38,"p":1.0},{"w":"공을","s":102.38,"e":102.7,"p":1.0},{"w":"덮을","s":102.7,"e":103.08,"p":1.0},{"w":"수","s":103.08,"e":103.16,"p":1.0},{"w":"있어요.","s":103.16,"e":103.58,"p":1.0}]},{"start":104.2,"end":107.98,"text":"제가 원래 디딤발로 공을 자주 밟아서 넘어지거든요.","words":[{"w":"제가","s":104.2,"e":104.42,"p":0.99},{"w":"원래","s":104.42,"e":104.82,"p":1.0},{"w":"디딤발로","s":104.82,"e":105.6,"p":1.0},{"w":"공을","s":105.6,"e":106.14,"p":1.0},{"w":"자주","s":106.14,"e":106.4,"p":1.0},{"w":"밟아서","s":106.4,"e":106.9,"p":1.0},{"w":"넘어지거든요.","s":106.9,"e":107.98,"p":0.99}]},{"start":108.58,"end":110.28,"text":"오늘은 안 넘어질게요.","words":[{"w":"오늘은","s":108.58,"e":109.32,"p":0.99},{"w":"안","s":109.32,"e":109.56,"p":0.88},{"w":"넘어질게요.","s":109.56,"e":110.28,"p":0.96}]},{"start":110.28,"end":113.64,"text":"다 functioning.","words":[{"w":"다","s":110.28,"e":111.34,"p":0.0},{"w":"functioning.","s":112.78,"e":113.64,"p":0.0}]},{"start":113.64,"end":114.42,"text":"하나, 둘, 셋.","words":[{"w":"하나,","s":113.64,"e":113.72,"p":0.29},{"w":"둘,","s":113.92,"e":114.02,"p":1.0},{"w":"셋.","s":114.28,"e":114.42,"p":1.0}]},{"start":114.96,"end":118.2,"text":"하나, 둘, 셋.","words":[{"w":"하나,","s":114.96,"e":115.2,"p":0.02},{"w":"둘,","s":115.66,"e":117.46,"p":0.99},{"w":"셋.","s":117.88,"e":118.2,"p":1.0}]},{"start":123.88,"end":124.52,"text":"나이스!","words":[{"w":"나이스!","s":123.88,"e":124.52,"p":0.73}]},{"start":124.92,"end":126.44,"text":"깔끔하게 들어갔어요.","words":[{"w":"깔끔하게","s":124.92,"e":125.82,"p":1.0},{"w":"들어갔어요.","s":125.82,"e":126.44,"p":1.0}]},{"start":129.04,"end":131.8,"text":"오늘 진짜 물 좀 마시고 할게요.","words":[{"w":"오늘","s":129.04,"e":129.62,"p":0.98},{"w":"진짜","s":129.62,"e":130.02,"p":0.99},{"w":"물","s":130.02,"e":131.0,"p":0.97},{"w":"좀","s":131.0,"e":131.14,"p":0.99},{"w":"마시고","s":131.14,"e":131.46,"p":1.0},{"w":"할게요.","s":131.46,"e":131.8,"p":0.98}]},{"start":137.62,"end":138.74,"text":"세번째 포인트.","words":[{"w":"세번째","s":137.62,"e":138.18,"p":0.73},{"w":"포인트.","s":138.18,"e":138.74,"p":1.0}]},{"start":139.38,"end":141.58,"text":"트래핑할 때는 공을 멈추는 게 아니라","words":[{"w":"트래핑할","s":139.38,"e":139.84,"p":0.92},{"w":"때는","s":139.84,"e":140.08,"p":1.0},{"w":"공을","s":140.08,"e":140.74,"p":1.0},{"w":"멈추는","s":140.74,"e":141.14,"p":1.0},{"w":"게","s":141.14,"e":141.26,"p":0.46},{"w":"아니라","s":141.26,"e":141.58,"p":1.0}]},{"start":141.58,"end":143.68,"text":"다음 방향으로 보내는 거예요.","words":[{"w":"다음","s":141.58,"e":142.54,"p":0.98},{"w":"방향으로","s":142.54,"e":143.02,"p":1.0},{"w":"보내는","s":143.02,"e":143.38,"p":1.0},{"w":"거예요.","s":143.38,"e":143.68,"p":0.97}]},{"start":144.06,"end":145.48,"text":"공을 멈추려고 하면","words":[{"w":"공을","s":144.06,"e":144.64,"p":1.0},{"w":"멈추려고","s":144.64,"e":145.18,"p":1.0},{"w":"하면","s":145.18,"e":145.48,"p":1.0}]},{"start":145.48,"end":147.74,"text":"오히려 공이 튀어나가요.","words":[{"w":"오히려","s":145.48,"e":146.6,"p":1.0},{"w":"공이","s":146.6,"e":147.12,"p":1.0},{"w":"튀어나가요.","s":147.12,"e":147.74,"p":0.99}]},{"start":148.2,"end":150.28,"text":"발을 살짝 뒤로 빼주면서","words":[{"w":"발을","s":148.2,"e":148.86,"p":1.0},{"w":"살짝","s":148.86,"e":149.28,"p":1.0},{"w":"뒤로","s":149.28,"e":149.68,"p":1.0},{"w":"빼주면서","s":149.68,"e":150.28,"p":1.0}]},{"start":150.28,"end":152.08,"text":"방향만 바꿔주세요.","words":[{"w":"방향만","s":150.28,"e":151.48,"p":1.0},{"w":"바꿔주세요.","s":151.48,"e":152.08,"p":1.0}]},{"start":152.08,"end":176.11,"text":"이 차이가 정말 중요해요 터치가 조금 길었네요 그렇죠 이게 완벽한 퍼스트 터치 에요","words":[{"w":"이","s":152.08,"e":153.0,"p":0.93},{"w":"차이가","s":153.0,"e":153.5,"p":1.0},{"w":"정말","s":153.5,"e":154.18,"p":1.0},{"w":"중요해요","s":154.18,"e":154.84,"p":1.0},{"w":"터치가","s":162.68,"e":163.72,"p":0.71},{"w":"조금","s":163.72,"e":164.08,"p":1.0},{"w":"길었네요","s":164.08,"e":164.72,"p":0.99},{"w":"그렇죠","s":172.11,"e":173.09,"p":0.9},{"w":"이게","s":173.09,"e":174.23,"p":0.81},{"w":"완벽한","s":174.23,"e":175.09,"p":1.0},{"w":"퍼스트","s":175.09,"e":175.47,"p":0.99},{"w":"터치","s":175.47,"e":175.81,"p":0.93},{"w":"에요","s":175.81,"e":176.11,"p":0.54}]},{"start":179.09,"end":192.67,"text":"오늘 배운거 정리해볼게요 고개들기 디딤발걸이 이 세가지만 바꿔도 완전히 달라져요","words":[{"w":"오늘","s":179.09,"e":179.78,"p":0.96},{"w":"배운거","s":179.78,"e":180.26,"p":0.76},{"w":"정리해볼게요","s":180.26,"e":181.22,"p":0.85},{"w":"고개들기","s":181.22,"e":183.18,"p":0.9},{"w":"디딤발걸이","s":183.18,"e":184.36,"p":0.87},{"w":"이","s":184.36,"e":184.86,"p":0.95},{"w":"세가지만","s":188.79,"e":189.41,"p":0.89},{"w":"바꿔도","s":189.41,"e":189.81,"p":0.99},{"w":"완전히","s":191.25,"e":191.93,"p":0.99},{"w":"달라져요","s":191.93,"e":192.67,"p":0.99}]},{"start":192.67,"end":199.23,"text":"오늘은 여기까지에요 연습해보시고 궁금한건 댓글로 남겨주세요 감사합니다","words":[{"w":"오늘은","s":192.67,"e":193.35,"p":0.98},{"w":"여기까지에요","s":193.35,"e":194.25,"p":0.8},{"w":"연습해보시고","s":194.25,"e":195.73,"p":0.93},{"w":"궁금한건","s":195.73,"e":196.57,"p":0.93},{"w":"댓글로","s":196.57,"e":197.01,"p":1.0},{"w":"남겨주세요","s":197.01,"e":197.71,"p":0.99},{"w":"감사합니다","s":197.71,"e":199.23,"p":0.99}]}],"analysis":{"silences":[{"start":0.0,"end":1.21},{"start":2.64,"end":3.62},{"start":11.37,"end":14.7},{"start":23.87,"end":24.68},{"start":26.38,"end":27.28},{"start":48.25,"end":51.02},{"start":57.11,"end":58.62},{"start":66.77,"end":69.25},{"start":69.57,"end":72.11},{"start":72.41,"end":74.38},{"start":80.64,"end":81.44},{"start":83.96,"end":87.71},{"start":100.52,"end":101.62},{"start":108.21,"end":109.02},{"start":118.28,"end":119.45},{"start":119.81,"end":124.0},{"start":132.03,"end":136.62},{"start":154.83,"end":157.97},{"start":158.26,"end":161.62},{"start":162.51,"end":163.42},{"start":166.32,"end":171.04},{"start":171.4,"end":172.83},{"start":178.23,"end":179.56},{"start":181.46,"end":182.67},{"start":197.88,"end":198.88},{"start":199.53,"end":201.54}],"loud_peaks":[{"time":1.0,"rms_db":-25.1},{"time":69.0,"rms_db":-22.1},{"time":111.0,"rms_db":-26.7},{"time":119.0,"rms_db":-22.1},{"time":127.0,"rms_db":-14.6},{"time":157.0,"rms_db":-24.2},{"time":171.0,"rms_db":-21.8}]},"truth":[[1.2,6.8,"안녕하세요, 여러분. 오늘은 퍼스트 터치에 대해서 같이 알아볼게요.","say"],[7.32,7.89,"어…","filler"],[8.51,11.38,"왜 다들 첫 터치에서 공을 놓칠까요?","say"],[14.59,19.45,"사실 이건 발 기술 문제라기보다 준비 자세 문제인 경우가 많아요.","say"],[19.98,22.89,"그래서 오늘은 세 가지만 기억하시면 돼요.","say"],[23.52,24.05,"음…","filler"],[24.65,31.01,"자, 첫 번째 포인트. 공이 오기 전에 고개를 들어서 주변을 먼저 보세요.","say"],[31.4,37.41,"많은 분들이 공만 보고 있다가 공이 오면 그제서야 어디로 갈지 생각하시거든요.","say"],[38.11,41.73,"그러면 이미 늦어요. 수비가 바로 붙어 버리니까요.","say"],[42.13,48.25,"이게 진짜 핵심이에요. 공을 받기 전에 다음 동작이 이미 정해져 있어야 해요.","say"],[50.98,54.26,"그래서 인사이드로 공을 받을 때는 발목에","ng"],[54.76,57.18,"아 잠깐만요, 다시 할게요.","slate"],[58.58,64.65,"그래서 인사이드로 공을 받을 때는 발목에 힘을 빼고 부드럽게 받아야 해요.","say"],[65.15,66.83,"한 번 보여 드릴게요.","say"],[74.31,77.41,"좋아요. 이렇게 공이 발에 딱 붙어야 해요.","say"],[78.01,84.03,"그리고 이건 그냥 참고로만 들으세요. 공 바람은 조금 빼고 하시는 게 편해요.","say"],[87.64,88.3,"자…","filler"],[88.83,91.33,"두 번째 포인트는 디딤발이에요.","say"],[91.98,96.45,"디딤발이 공이랑 너무 가까우면 터치가 무조건 길어져요.","say"],[97.02,103.68,"디딤발은 공 옆으로 한 뼘 정도 떨어뜨려 주세요. 그래야 몸이 공을 덮을 수 있어요.","say"],[104.2,110.41,"제가 원래 디딤발로 공을 자주 밟아서 넘어지거든요. 오늘은 안 넘어질게요.","say"],[112.61,118.22,"자, 하나 둘 셋에 맞춰서 받아 볼게요. 하나, 둘, 셋!","say"],[123.95,126.57,"나이스! 깔끔하게 들어갔어요.","say"],[128.27,132.01,"아 근데 오늘 진짜 덥네요. 물 좀 마시고 할게요.","say"],[136.6,137.18,"어…","filler"],[137.62,143.86,"세 번째 포인트, 트래핑할 때는 공을 멈추는 게 아니라 다음 방향으로 보내는 거예요.","say"],[144.33,152.24,"공을 멈추려고 하면 오히려 공이 튀어 나가요. 발을 살짝 뒤로 빼 주면서 방향만 바꿔 주세요.","say"],[152.89,154.87,"이 차이가 정말 중요해요.","say"],[161.61,164.82,"아 아깝다. 터치가 조금 길었네요.","say"],[165.32,166.28,"다시 한번 해 볼게요.","say"],[172.78,176.14,"그렇죠! 이게 완벽한 퍼스트 터치예요.","say"],[179.54,187.02,"오늘 배운 거 정리해 볼게요. 고개 들기, 디딤발 거리, 그리고 다음 방향으로 받기.","say"],[187.61,188.15,"음…","filler"],[188.65,192.68,"이 세 가지만 바꿔도 첫 터치가 완전히 달라져요.","say"],[193.09,199.52,"오늘은 여기까지예요. 연습해 보시고 궁금한 건 댓글로 남겨 주세요. 감사합니다.","say"]],"demos":[[67.51,74.01,[69.25,72.11]],[118.65,123.65,[119.45]],[155.31,161.31,[157.97]],[166.98,172.48,[171.04]]]},"MSGRAW02":{"duration":115.75,"transcript":[{"start":0.85,"end":9.73,"text":"안녕하세요. 오늘은 패스하고 바로 움직이는 연습을 해볼게요. 패스하고 그 자리에 서 있으면 왜 안될까요?","words":[{"w":"안녕하세요.","s":0.85,"e":1.55,"p":0.95},{"w":"오늘은","s":2.05,"e":3.05,"p":1.0},{"w":"패스하고","s":3.05,"e":3.81,"p":1.0},{"w":"바로","s":3.81,"e":4.23,"p":1.0},{"w":"움직이는","s":4.23,"e":4.83,"p":1.0},{"w":"연습을","s":4.83,"e":5.49,"p":1.0},{"w":"해볼게요.","s":5.49,"e":5.91,"p":0.98},{"w":"패스하고","s":6.47,"e":7.39,"p":1.0},{"w":"그","s":7.39,"e":7.65,"p":1.0},{"w":"자리에","s":7.65,"e":7.95,"p":1.0},{"w":"서","s":7.95,"e":8.11,"p":1.0},{"w":"있으면","s":8.11,"e":8.43,"p":0.87},{"w":"왜","s":8.43,"e":9.01,"p":1.0},{"w":"안될까요?","s":9.01,"e":9.73,"p":0.91}]},{"start":11.92,"end":19.02,"text":"음... 패스를 하는 순간 수비는 공을 따라가요. 그때가 바로 움직일 타이밍이에요.","words":[{"w":"음...","s":11.92,"e":12.74,"p":0.56},{"w":"패스를","s":12.74,"e":13.98,"p":1.0},{"w":"하는","s":13.98,"e":14.26,"p":1.0},{"w":"순간","s":14.26,"e":14.66,"p":1.0},{"w":"수비는","s":14.66,"e":15.5,"p":0.96},{"w":"공을","s":15.5,"e":15.88,"p":1.0},{"w":"따라가요.","s":15.88,"e":16.34,"p":1.0},{"w":"그때가","s":16.68,"e":17.62,"p":0.99},{"w":"바로","s":17.62,"e":17.88,"p":1.0},{"w":"움직일","s":17.88,"e":18.38,"p":1.0},{"w":"타이밍이에요.","s":18.38,"e":19.02,"p":1.0}]},{"start":19.66,"end":32.8,"text":"자, 첫 번째 동작. 패스하고 바로 앞으로 두 걸음 뛰어나가세요. 좋습니다.","words":[{"w":"자,","s":19.66,"e":19.84,"p":1.0},{"w":"첫","s":20.18,"e":20.94,"p":1.0},{"w":"번째","s":20.94,"e":21.24,"p":0.84},{"w":"동작.","s":21.24,"e":21.66,"p":1.0},{"w":"패스하고","s":21.92,"e":22.76,"p":1.0},{"w":"바로","s":22.76,"e":23.02,"p":1.0},{"w":"앞으로","s":23.02,"e":23.68,"p":1.0},{"w":"두","s":23.68,"e":24.2,"p":1.0},{"w":"걸음","s":24.2,"e":24.52,"p":0.99},{"w":"뛰어나가세요.","s":24.52,"e":25.34,"p":1.0},{"w":"좋습니다.","s":32.06,"e":32.8,"p":1.0}]},{"start":32.8,"end":38.8,"text":"이렇게 패스와 동작. 이렇게 패스와 동시에 몸이 나가야 해요. 월스는 이 타이밍이 생명이에요.","words":[{"w":"이렇게","s":32.8,"e":33.98,"p":0.98},{"w":"패스와","s":33.98,"e":34.78,"p":1.0},{"w":"동작.","s":34.78,"e":35.2,"p":0.5},{"w":"이렇게","s":35.22,"e":35.22,"p":0.27},{"w":"패스와","s":35.22,"e":35.22,"p":0.82},{"w":"동시에","s":35.22,"e":35.22,"p":1.0},{"w":"몸이","s":35.22,"e":35.64,"p":1.0},{"w":"나가야","s":35.64,"e":36.02,"p":1.0},{"w":"해요.","s":36.02,"e":36.28,"p":0.91},{"w":"월스는","s":36.56,"e":37.3,"p":0.89},{"w":"이","s":37.3,"e":37.58,"p":1.0},{"w":"타이밍이","s":37.58,"e":38.08,"p":1.0},{"w":"생명이에요.","s":38.08,"e":38.8,"p":1.0}]},{"start":41.88,"end":46.9,"text":"두 번째 동작은 패스하고 옆으로 아니다. 다시 할게요.","words":[{"w":"두","s":41.88,"e":42.02,"p":0.84},{"w":"번째","s":42.02,"e":42.34,"p":1.0},{"w":"동작은","s":42.34,"e":42.94,"p":1.0},{"w":"패스하고","s":42.94,"e":44.04,"p":1.0},{"w":"옆으로","s":44.04,"e":44.62,"p":1.0},{"w":"아니다.","s":44.62,"e":45.6,"p":0.59},{"w":"다시","s":45.96,"e":46.5,"p":1.0},{"w":"할게요.","s":46.5,"e":46.9,"p":1.0}]},{"start":48.12,"end":53.34,"text":"두 번째 동작은 패스하고 옆으로 빠지면서 다시 공을 받는 거예요.","words":[{"w":"두","s":48.12,"e":48.58,"p":1.0},{"w":"번째","s":48.58,"e":48.9,"p":1.0},{"w":"동작은","s":48.9,"e":49.46,"p":1.0},{"w":"패스하고","s":49.46,"e":50.26,"p":1.0},{"w":"옆으로","s":50.26,"e":51.14,"p":1.0},{"w":"빠지면서","s":51.14,"e":51.72,"p":1.0},{"w":"다시","s":51.72,"e":52.34,"p":1.0},{"w":"공을","s":52.34,"e":52.76,"p":1.0},{"w":"받는","s":52.76,"e":53.06,"p":1.0},{"w":"거예요.","s":53.06,"e":53.34,"p":0.99}]},{"start":61.21,"end":67.47,"text":"아이고, 공이 조금 뒤로 갔네요. 괜찮아요. 저도 처음엔 이거 잘 못했어요.","words":[{"w":"아이고,","s":61.21,"e":61.65,"p":1.0},{"w":"공