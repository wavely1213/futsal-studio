d":"885b1a2a","start":33.62,"end":36.58,"text":"이력 패스와 동시에 몸이 나가야 해요.","wt":[3362,62,0,46,0,52,0,72,0,36,0,28],"sh":[3],"shn":6},{"id":"3766d7b1","start":37.18,"end":39.5,"text":"월패스는 이 타이밍이 생명이에요.","wt":[3718,60,0,50,0,54,0,68],"sh":[3],"shn":4},{"id":"dc121517","start":42.32,"end":45.54,"text":"두번째 동작은 패스하고 옆으로,","wt":[4232,62,0,62,0,100,0,76],"sh":[2],"shn":4},{"id":"e2b6fd31","start":45.54,"end":46.2,"text":"아니다.","wt":[4554,66]},{"id":"33dffd70","start":46.6,"end":47.54,"text":"다시 할게요.","wt":[4660,60,0,34]},{"id":"d80c35f9","start":48.78,"end":51.1,"text":"두번째 동작은 패스하고","wt":[4878,86,0,64,0,82],"sh":[2],"shn":3},{"id":"5653f5d4","start":51.1,"end":53.92,"text":"옆으로 빠지면서 다시 공을 받는 거예요.","wt":[5110,66,0,62,0,62,0,38,0,26,0,28],"sh":[2],"shn":6},{"id":"bca255df","start":60.52,"end":61.66,"text":"아이고,","wt":[6052,114]},{"id":"dc21d512","start":62,"end":64.3,"text":"공이 조금 뒤로 갔네요.","wt":[6200,98,0,16,0,38,0,50]},{"id":"905bd2c3","start":64.3,"end":65.12,"text":"괜찮아요.","wt":[6430,82]},{"id":"5b0bd573","start":65.48,"end":67.54,"text":"저도 처음엔 잘 못했어요.","wt":[6548,14,0,46,0,80,0,66]},{"id":"84a6317a","start":69.05,"end":71.62,"text":"어, 다시 해볼게요.","wt":[6905,57,76,36,0,88],"sh":[2],"shn":3},{"id":"a4d23205","start":77.14,"end":79.58,"text":"와, 이거죠.","wt":[7714,114,38,68],"sh":[1],"shn":2},{"id":"fabc04cd","start":79.58,"end":80.56,"text":"완벽해요.","wt":[7958,98]},{"id":"6fb29611","start":84.78,"end":86.6,"text":"포인트는 패스하고","wt":[8478,114,0,68]},{"id":"52a12733","start":86.6,"end":88.4,"text":"절대 멈추지 않는 거예요.","wt":[8660,74,0,56,0,18,0,32]},{"id":"b4d5c7a5","start":88.4,"end":90.82,"text":"그리고 이건 여담인데","wt":[8840,94,0,80,0,68],"sh":[2],"shn":3},{"id":"70209bcb","start":90.82,"end":93.62,"text":"공은 항상 두 개쯤 챙겨오세요.","wt":[9082,88,0,44,0,30,0,36,0,82],"sh":[4],"shn":5},{"id":"f117214d","start":94.36,"end":95.72,"text":"하나, 둘,","wt":[9436,12,34,60]},{"id":"8932487e","start":95.72,"end":97.86,"text":"셋 리듬으로 움직여 보세요.","wt":[9572,46,0,64,0,74,0,30]},{"id":"fa43a81d","start":102.86,"en