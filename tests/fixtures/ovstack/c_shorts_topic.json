hy":"최고 시범 장면","text":"왜 다들 처치에서 공을 놓칠까요?"},{"t_src":163.78,"why":"웃거나 놀란 얼굴","text":"왜 다들 처치에서 공을 놓칠까요?"},{"t_src":74.92,"why":"성공한 순간","text":"왜 다들 처치에서 공을 놓칠까요?"},{"t_src":124.22,"why":"성공한 순간","text":"왜 다들 처치에서 공을 놓칠까요?"},{"t_src":42.72,"why":"강조하는 말","text":"왜 다들 처치에서 공을 놓칠까요?"}],"summary":{"captions":1,"sfx":1,"punch":0,"replay":0,"freeze":0,"montage":0,"bgm":2,"length":35.18,"kinds":{"inner":1,"hook":1,"bgm":2},"tactic":0,"text":"예능 자막 1 · 효과음 1 · 확대 0 · 다시 보기 0 · 배경음악 2곡 · 길이 00:35"},"notes":[],"hook":"왜 다들 처치에서 공을 놓칠까요?","topic":"퍼스트 터치 레슨","topicLine":"퍼스트 터치 레슨 · 포인트 3","opening":"트래핑 꿀팁","bgm":[{"a":0,"b":12.46,"mood":"잔잔"},{"a":12.46,"b":35.18,"mood":"경쾌"}]},"captions":[{"id":"65b43865","start":0,"end":1.56,"text":"안녕하세요","wt":[0,156]},{"id":"1e6c7ba3","start":1.56,"end":2.62,"text":"여러분.","wt":[156,78]},{"id":"b529d367","start":2.62,"end":5.22,"text":"오늘은 퍼스트 터치에 대해서","wt":[262,114,0,52,0,60,0,34],"sh":[1],"shn":4},{"id":"281f4c9c","start":5.22,"end":6.64,"text":"같이 알아볼게요.","wt":[522,60,0,82]},{"id":"7c13c9f1","start":7.44,"end":9.92,"text":"왜 다들 처치에서","wt":[744,120,0,46,0,82],"sh":[2],"shn":3},{"id":"2512d497","start":9.92,"end":11.24,"text":"공을 놓칠까요?","wt":[992,72,0,60]},{"id":"324cc687","start":13.72,"end":15.38,"text":"사실 이건","wt":[1372,120,0,46]},{"id":"05f44d62","start":15.38,"end":17.3,"text":"발 기술 문제라기보다","wt":[1538,92,0,26,0,74]},{"id":"cffb83a4","start":17.3,"end":19.4,"text":"준비 자세 문제인 경우가 많아요.","wt":[1730,58,0,30,0,42,0,40,0,40],"sh":[2],"shn":5},{"id":"5fd02cc9","start":19.74,"end":21.9,"text":"그래서 오늘은 세 가지만","wt":[1974,54,0,62,0,64,0,36]},{"id":"7159dec5","start":21.9,"end":22.76,"text":"기억하시면 돼요.","wt":[2190,62,0,24]},{"id":"bb9cd3d9","start":24.58,"end":26.86,"text":"자, 첫번째 포인트.","wt":[2458,90,0,90,0,48],"sh":[1],"shn":3},{"id":"323f3c0b","start":27.22,"end":29.44,"text":"공이 오기 전에 고개를 들어서","wt":[2722,72,0,20,0,22,0,62,0,46],"sh":[3],"shn":5},{"id":"3e1cb2f7","start":29.44,"end":30.92,"text":"주변을 먼저 보세요.","wt":[2944,72,0,32,0,44]},{"id":"d0fde6c7","start":31.58,"end":32.82,"text":"많은 분들이 공만","wt":[3158,26,0,46,0,52]},{"id":"82f60af9","start":32.82,"end":34.66,"text":"보고 있다가 공이 오면","wt":[3282,24,0,46,0,84,0,30]},{"id":"7b9799d4","start":34.66,"end":37.46,"text":"그제서야 어디로 갈지 생각하시거든요.","wt":[3466,84,0,68,0,36,0,92],"sh":[2],"shn":4},{"id":"f903df65","start":37.78,"end":39.32,"text":"그러면 이미 늦어요.","wt":[3778,76,0,36,0,42]},{"id":"7ec9e02f","start":39.74,"end":41.88,"text":"수비가 바로 붙어버리니까요.","wt":[3974,78,0,44,0,92]},{"id":"d08999f1","start":42.26,"end":43.58,"text":"이게 진짜 핵심이에요.","wt":[4226,26,0,44,0,62]},{"id":"c19d6459","start":44.48,"end":46.88,"text":"공을 받기 전에 다음 동작이","wt":[4448,64,0,26,0,26,0,70,0,54],"sh":[3],"shn":5},{"id":"745f829f","start":46.88,"end":48.34,"text":"이미 정해져 있어야 해요.","wt":[4688,32,0,48,0,34,0,32]},{"id":"2af73422","start":51.22,"end":52.82,"text":"그래서 인사이드로","wt":[5122,80,0,80]},{"id":"4f3ee0d7","start":52.82,"end":54.54,"text":"공을 받을 때는 발목에,","wt":[5282,30,0,26,0,20,0,82]},{"id":"59fe49df","start":54.54,"end":55.94,"text":"아, 잠깐만요.","wt":[5454,54,26,60]},{"id":"f271c46d","start":56.26,"end":57.18,"text":"다시 할게요.","wt":[5626,58,0,34]},{"id":"9e1fde5e","start":58.98,"end":60.58,"text":"그래서 인사이드로","wt":[5898,80,0,80]},{"id":"42a48ff0","start":60.58,"end":63.34,"text":"공을 받을 때는 발목에 힘을 빼고","wt":[6058,38,0,30,0,24,0,110,0,34,0,40],"sh":[3],"shn":6},{"id":"8d557324","start":63.34,"end":64.88,"text":"부드럽게 받아야 해요.","wt":[6334,86,0,40,0,28]},{"id":"153d9427","start":65.46,"end":66.88,"text":"한번 보여드릴게요.","wt":[6546,24,0,118]},{"id":"224db7c5","start":73.86,"end":74.86,"text":"좋아요.","wt":[7386,100]},{"id":"33628be9","start":75.4,"end":77.6,"text":"이렇게 공이 발에 딱 붙어야 해요.","wt":[7540,52,0,46,0,28,0,16,0,50,0,28],"sh":[3],"shn":6},{"id":"1f8025e9","start":78.32,"end":81,"text":"그리고 이건 그냥 참고로만 들으세요.","wt":[7832,18,0,52,0,80,0,70,0,48],"sh":[3],"shn":5},{"id":"e1985e2e","start":81.72,"end":84.24,"text":"공바람은 조금 빼고 하시는 게 편해요.","wt":[8172,86,0,34,0,42,0,34,0,12,0,44],"sh":[3],"shn":6},{"id":"31996b8d","start":87.04,"end":90,"text":"자, 두 번째 포인트는","wt":[8704,100,48,42,0,32,0,74],"sh":[1],"shn":4},{"id":"24e3ed4b","start":90,"end":91.12,"text":"디딤발이에요.","wt":[9000,112]},{"id":"60e558b0","start":91.66,"end":94.12,"text":"디딤발이 공이랑 너무 가까우면","wt":[9166,100,0,44,0,32,0,70],"sh":[1],"shn":4},{"id":"58a43b19","start":94.12,"end":96.38,"text":"터치가 무조건 길어져요.","wt":[9412,108,0,54,0,64],"sh":[2],"shn":3},{"id":"f295c35a","start":96.88,"end":98.64,"text":"디딤발은 공 옆으로","wt":[9688,80,0,42,0,54]},{"id":"462081c7","start":98.64,"end":100.46,"text":"한 뼘 정도 떨어뜨려주세요.","wt":[9864,40,0,30,0,26,0,86]},{"id":"b377d066","start":101.16,"end":103.52,"text":"그래야 몸을 덮을 수 있어요.","wt":[10116,88,0,56,0,40,0,10,0,42],"sh":[2],"shn":5},{"id":"366dab35","start":104.22,"end":106.82,"text":"제가 원래 디딤발로 공을 자주 밟아서","wt":[10422,16,0,30,0,70,0,66,0,28,0,50],"sh":[3],"shn":6},{"id":"816745a9","start":106.82,"end":107.84,"text":"넘어지거든요.","wt":[10682,102]},{"id":"57e92fa3","start":108.36,"end":110.12,"text":"오늘은 안 넘어질게요.","wt":[10836,78,0,22,0,76]},{"id":"4568c277","start":111.7,"end":113.7,"text":"자, 하나,","wt":[11170,88,42,58]},{"id":"a0584828","start":113.7,"end":115.4,"text":"둘, 셋에 맞춰서 받아볼게요.","wt":[11370,20,0,58,0,38,0,54]},{"id":"7b146211","start":116.56,"end":118.06,"text":"하나, 둘, 셋.","wt":[11656,16,30,40,28,36]},{"id":"dc5b222e","start":123.92,"end":124.8,"text":"나이스!","wt":[12392,88]},{"id":"0cf43471","start":124.8,"end":126.36,"text":"깔끔하게 들어갔어요.","wt":[12480,88,0,68]},{"id":"dc7be821","start":128.8,"end":130.3,"text":"진짜 덥네요.","wt":[12880,96,0,54]},{"id":"91a20c3a","start":130.64,"end":131.7,"text":"물 좀 마시고 할게요.","wt":[13064,28,0,14,0,36,0,28]},{"id":"cdb90b4a","start":136.74,"end":138.92,"text":"세 번째 포인트.","wt":[13674,96,0,28,0,68]},{"id":"486121e7","start":138.92,"end":141.32,"text":"트래핑할 때는 공을 멈추는 게","wt":[13892,88,0,26,0,78,0,36,0,12],"sh":[2],"shn":5},{"id":"593d77e1","start":141.32,"end":143.66,"text":"아니라 다음 방향으로 보내는 거예요.","wt":[14132,30,0,90,0,50,0,40,0,24],"sh":[3],"shn":5},{"id":"5b3badc4","start":144.18,"end":145.36,"text":"공을 멈추려고 하면","wt":[14418,40,0,48,0,30]},{"id":"70ce932e","start":145.36,"end":147.28,"text":"오히려 공이 튀어나가요.","wt":[14536,88,0,40,0,64]},{"id":"df91dd9f","start":148.84,"end":150.44,"text":"살짝 뒤로 빼주면서","wt":[14884,36,0,48,0,76]},{"id":"20c7dfa9","start":150.44,"end":152.1,"text":"방향만 바꿔주세요.","wt":[15044,104,0,62]},{"id":"c0035d6f","start":152.64,"end":154.84,"text":"이 차이가 정말 중요해요.","wt":[15264,38,0,40,0,70,0,72],"sh":[2],"shn":4},{"id":"56a074f9","start":160.72,"end":162.5,"text":"아, 아깝다.","wt":[16072,116,12,50]},{"id":"f3544b00","start":162.96,"end":164.68,"text":"터치가 조금 길었네요.","wt":[16296,70,0,44,0,58]},{"id":"87fe342d","start":165.32,"end":166.84,"text":"다시 한번 해볼게요.","wt":[16532,24,0,32,0,96]},{"id":"cf4de98b","start":172.66,"end":173.82,"text":"그렇죠.","wt":[17266,116]},{"id":"485748f1","start":174.42,"end":176.8,"text":"이게 완벽한 퍼스트 터치예요.","wt":[17442,74,0,54,0,46,0,64],"sh":[2],"shn":4},{"id":"5ac1e263","start":179.3,"end":182.1,"text":"오늘 배운거 정리해볼게요.","wt":[17930,116,0,54,0,110],"sh":[2],"shn":3},{"id":"200169e6","start":182.54,"end":184.16,"text":"고개 들기,","wt":[18254,98,0,42]},{"id":"60e77d51","start":184.16,"end":185.04,"text":"디딤발거리,","wt":[18416,88]},{"id":"536582b4","start":185.7,"end":187.6,"text":"그리고 다음 방향으로 받기.","wt":[18570,0,0,88,0,60,0,42]},{"id":"57065498","start":188.46,"end":190.6,"text":"이 세가지만 바꿔도","wt":[18846,116,0,56,0,42]},{"id":"83126c01","start":190.6,"end":193.32,"text":"첫 터치가 완전히 달라져요.","wt":[19060,58,0,46,0,94,0,74],"sh":[2],"shn":4},{"id":"495c1079","start":193.7,"end":195.06,"text":"오늘은 여기까지에요.","wt":[19370,44,0,92]},{"id":"41f0caaa","start":195.4,"end":196.52,"text":"연습해보시고","wt":[19540,112]},{"id":"cec430c2","start":196.52,"end":198.74,"text":"궁금한건 댓글로 남겨주세요.","wt":[19652,114,0,46,0,62],"sh":[2],"shn":3},{"id":"638ad5df","start":199.16,"end":199.88,"text":"감사합니다.","wt":[19916,72]}],"speech":[],"info":{"duration":202.26,"width":1920,"height":1080,"fps":30,"hdr":null},"source":"20261008_MSGRAW01_퍼스트 터치 레슨.mp4"}}